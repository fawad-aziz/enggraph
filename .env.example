# EngGraph configuration — copy to .env and fill in real values.
# .env files containing real secrets are gitignored. Never commit secrets.

# Application mode: demo (fixtures, no external credentials) | live (real connectors)
ENGGRAPH_MODE=demo

# PostgreSQL (application configuration, jobs, audit)
POSTGRES_DSN=postgresql+psycopg://enggraph:CHANGE_ME@localhost:5432/enggraph

# Neo4j (engineering graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# Session signing secret (generate with: python -c "import secrets;print(secrets.token_hex(32))")
ENGGRAPH_SESSION_SECRET=CHANGE_ME
# Session lifetime in hours (1..72)
ENGGRAPH_SESSION_TTL_HOURS=12

# Azure DevOps PAT (live mode only). Least-privilege scopes documented in
# docs/azure-devops-setup.md. Supplied out-of-band; never committed.
AZURE_DEVOPS_PAT=
# Azure DevOps organization to configure
AZURE_DEVOPS_ORGANIZATION=

# Query limits (bounded traversals, FR-08/FR-09, MCP)
ENGGRAPH_MAX_DEPTH=4
ENGGRAPH_MAX_RESULTS=200

# Ports
BACKEND_PORT=8000
MCP_PORT=8100
